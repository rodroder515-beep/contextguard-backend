{
  "name": "contextguard-backend",
  "private": true,
  "version": "1.0.0",
  "description": "Standalone ContextGuard policy, authorization, and evaluation backend for AI workflows.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.server.json && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "node dist-server/index.js",
    "clean": "rm -rf dist-server",
    "lint": "tsc -p tsconfig.server.json",
    "server:dev": "tsx watch server/index.ts",
    "server:build": "tsc -p tsconfig.server.json && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "server:start": "node dist-server/index.js",
    "test:server": "node --import tsx --test server/tests/api.test.ts server/tests/evaluation.test.ts",
    "test": "node --import tsx --test server/tests/api.test.ts server/tests/evaluation.test.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
