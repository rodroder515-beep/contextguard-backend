# Port assigned by Render or local environment (defaults to 4000)
PORT=4000

# Runtime environment (development | test | production)
NODE_ENV=development

# Comma-separated list of allowed frontend CORS origins (required in production)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,https://your-frontend.vercel.app"

# Time-to-live in milliseconds for in-memory analysis tokens (default: 300000 = 5 minutes)
ANALYSIS_TTL_MS=300000
